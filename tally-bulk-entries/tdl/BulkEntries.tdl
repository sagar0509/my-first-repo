/* ============================================================================
   TDL ADD-ON: BULK RECEIPT & PAYMENT ENTRIES
   Target: TallyPrime 7.0 (Compatible with Tally.ERP 9 Release 6.6+)
   Version: 1.0
   Date: December 2025

   Description:
   Production-ready add-on for creating bulk bank receipt and payment entries
   through grid interface and XML import.

   Features:
   - Grid-based bulk entry for receipts and payments
   - XML import functionality
   - Configurable transaction types
   - Bill-wise allocation support
   - Comprehensive error handling
   - Performance optimized for 1000+ entries

   Menu Path: Gateway of Tally → Banking → Bulk Entries
============================================================================ */

;; ============================================================================
;; SECTION 1: SYSTEM DECLARATIONS & VARIABLES
;; ============================================================================

[System: Formula]

    ;; Global Variables for Configuration
    BE Config Receipt VchType  : "Receipt"
    BE Config Payment VchType  : "Payment"
    BE Transaction Types       : "Cash;Cheque;NEFT;RTGS;UPI;IMPS;Others"
    BE Narration Template      : "Txn:<<Type>> | Inst:<<No>> | Dt:<<Date>>"

    ;; Session Variables
    BE Selected Bank           : ""
    BE Current Mode            : ""  ;; "RECEIPT" or "PAYMENT"
    BE Import File Path        : ""
    BE Import Test Mode        : "No"
    BE Total Rows              : 0
    BE Success Count           : 0
    BE Failed Count            : 0
    BE Last Error              : ""

;; ============================================================================
;; SECTION 2: MENU DEFINITIONS
;; ============================================================================

;; Add main menu option under Banking
[#Menu: Gateway of Tally]
    Add : Key Item : BE Bulk Entries Menu : B : Banking
    Item : BE Bulk Entries Menu : Display : BE Bulk Entries Main

[Menu: BE Bulk Entries Main]
    Title   : "Bulk Entries"
    Width   : 40
    Item    : "Bulk Receipts" : Display : BE Bank Selection for Receipt
    Item    : "Bulk Payments" : Display : BE Bank Selection for Payment
    Item    : "XML Import"    : Display : BE XML Import Screen
    Item    : "Configuration" : Display : BE Config Screen
    Item    : "Quit"          : Key : Esc

;; ============================================================================
;; SECTION 3: BANK SELECTION SCREENS
;; ============================================================================

[Form: BE Bank Selection for Receipt]
    Width       : 60
    Height      : 20
    Border      : Thin Box

    Parts       : BE Bank Selection Header, BE Bank List Body

    On: Entry   : Set : BE Current Mode : "RECEIPT"

[Part: BE Bank Selection Header]
    Lines       : BE Bank Sel Title
    Repeat      : BE Bank Sel Title : 1
    Scroll      : Vertical

[Line: BE Bank Sel Title]
    Fields      : BE Bank Sel Title Field
    Local       : Field : Default : Style : Normal Bold

[Field: BE Bank Sel Title Field]
    Set as      : "Select Bank Account for Bulk Receipts"
    Style       : Normal Bold
    Align       : Centre
    Width       : 60
    Border      : Thin Bottom

[Part: BE Bank List Body]
    Lines       : BE Bank Line
    Repeat      : BE Bank Line : BE Bank Ledgers
    Scroll      : Vertical
    Option      : BE Bank Selected : $$Line > 0

[Line: BE Bank Line]
    Fields      : Medium Field, BE Bank Name Field
    Local       : Field : Default : Width : $$Width - 2

[Field: BE Bank Name Field]
    Set as      : $Name
    Style       : Normal
    Color       : Black

[Collection: BE Bank Ledgers]
    Type        : Ledger
    Childof     : "Bank Accounts"
    Fetch       : Name
    Sort        : Default : $Name

;; Bank Selection for Payment (Similar structure)
[Form: BE Bank Selection for Payment]
    Width       : 60
    Height      : 20
    Border      : Thin Box

    Parts       : BE Bank Selection Header Payment, BE Bank List Body Payment

    On: Entry   : Set : BE Current Mode : "PAYMENT"

[Part: BE Bank Selection Header Payment]
    Lines       : BE Bank Sel Title Payment
    Repeat      : BE Bank Sel Title Payment : 1
    Scroll      : Vertical

[Line: BE Bank Sel Title Payment]
    Fields      : BE Bank Sel Title Field Payment
    Local       : Field : Default : Style : Normal Bold

[Field: BE Bank Sel Title Field Payment]
    Set as      : "Select Bank Account for Bulk Payments"
    Style       : Normal Bold
    Align       : Centre
    Width       : 60
    Border      : Thin Bottom

[Part: BE Bank List Body Payment]
    Lines       : BE Bank Line Payment
    Repeat      : BE Bank Line Payment : BE Bank Ledgers
    Scroll      : Vertical
    Option      : BE Payment Bank Selected : $$Line > 0

[Line: BE Bank Line Payment]
    Fields      : Medium Field, BE Bank Name Field Payment
    Local       : Field : Default : Width : $$Width - 2

[Field: BE Bank Name Field Payment]
    Set as      : $Name
    Style       : Normal
    Color       : Black

;; Action on Bank Selection
[Action: BE Bank Selected]
    001 : Set : BE Selected Bank : $$SelectedValueFromCollectionByIdx : BE Bank Ledgers : $$Line
    002 : Display Form : BE Bulk Receipt Grid

[Action: BE Payment Bank Selected]
    001 : Set : BE Selected Bank : $$SelectedValueFromCollectionByIdx : BE Bank Ledgers : $$Line
    002 : Display Form : BE Bulk Payment Grid

;; ============================================================================
;; SECTION 4: OBJECT DEFINITIONS FOR GRID ENTRIES
;; ============================================================================

[Object: BE Receipt Entry]
    BE Entry Date       : Date      : $$SysInfo : DefaultDate
    BE Entry Ledger     : String    : ""
    BE Entry BillRef    : String    : "New Ref"
    BE Entry Amount     : Number    : 0
    BE Entry TxnType    : String    : "Cash"
    BE Entry InstNo     : String    : ""
    BE Entry InstDate   : Date      : $$SysInfo : DefaultDate
    BE Entry Narration  : String    : ""
    BE Entry Status     : String    : "New"  ;; New, Valid, Invalid, Posted
    BE Entry Error      : String    : ""
    BE Entry VchNumber  : String    : ""

[Object: BE Payment Entry]
    BE Entry Date       : Date      : $$SysInfo : DefaultDate
    BE Entry Ledger     : String    : ""
    BE Entry BillRef    : String    : "New Ref"
    BE Entry Amount     : Number    : 0
    BE Entry TxnType    : String    : "Cash"
    BE Entry InstNo     : String    : ""
    BE Entry InstDate   : Date      : $$SysInfo : DefaultDate
    BE Entry Narration  : String    : ""
    BE Entry Status     : String    : "New"
    BE Entry Error      : String    : ""
    BE Entry VchNumber  : String    : ""

;; ============================================================================
;; SECTION 5: BULK RECEIPT GRID SCREEN
;; ============================================================================

[Form: BE Bulk Receipt Grid]
    Width       : $$FullWidth
    Height      : $$FullHeight

    Parts       : BE Receipt Grid Header, BE Receipt Grid Body, BE Receipt Grid Footer

    Keys        : Ctrl+A : Call : BE Save All Receipts
    Keys        : Ctrl+N : Call : BE Add New Receipt Row
    Keys        : Alt+D  : Call : BE Delete Receipt Row

[Part: BE Receipt Grid Header]
    Lines       : BE Receipt Title Line, BE Receipt Subtitle Line, BE Receipt Column Headers
    Repeat      : BE Receipt Title Line     : 1
    Repeat      : BE Receipt Subtitle Line  : 1
    Repeat      : BE Receipt Column Headers : 1
    Scroll      : None

[Line: BE Receipt Title Line]
    Fields      : BE Receipt Title Field
    Local       : Field : Default : Style : Normal Bold

[Field: BE Receipt Title Field]
    Set as      : "Bulk Receipt Entries For : " + ##BE Selected Bank
    Style       : Normal Bold
    Align       : Centre
    Border      : Thin Bottom

[Line: BE Receipt Subtitle Line]
    Fields      : BE Receipt Subtitle Field
    Local       : Field : Default : Style : Small Bold

[Field: BE Receipt Subtitle Field]
    Set as      : "Entry for each line will be created and voucher numbers will be assigned automatically"
    Style       : Small
    Align       : Centre
    Color       : Blue
    Border      : Thin Bottom

[Line: BE Receipt Column Headers]
    Fields      : BE RH Date, BE RH Ledger, BE RH BillRef, BE RH Amount, BE RH TxnType, BE RH InstNo, BE RH InstDate, BE RH Narration
    Local       : Field : Default : Style : Small Bold, Border : Thin Bottom

[Field: BE RH Date]
    Set as      : "Date"
    Width       : 10
    Align       : Centre

[Field: BE RH Ledger]
    Set as      : "Ledger Name"
    Width       : 25
    Align       : Left

[Field: BE RH BillRef]
    Set as      : "Bill Ref"
    Width       : 12
    Align       : Left

[Field: BE RH Amount]
    Set as      : "Amount"
    Width       : 15
    Align       : Right

[Field: BE RH TxnType]
    Set as      : "Txn Type"
    Width       : 10
    Align       : Left

[Field: BE RH InstNo]
    Set as      : "Inst. No"
    Width       : 15
    Align       : Left

[Field: BE RH InstDate]
    Set as      : "Inst. Date"
    Width       : 10
    Align       : Centre

[Field: BE RH Narration]
    Set as      : "Narration"
    Width       : 30
    Align       : Left

[Part: BE Receipt Grid Body]
    Lines       : BE Receipt Data Line
    Repeat      : BE Receipt Data Line : BE Receipt Entries Collection
    Scroll      : Vertical
    Common Border : Yes

[Line: BE Receipt Data Line]
    Fields      : BE RD Date, BE RD Ledger, BE RD BillRef, BE RD Amount, BE RD TxnType, BE RD InstNo, BE RD InstDate, BE RD Narration, BE RD Status
    Right Fields: BE RD Status

    Local       : Field : Default : Width : 10

[Field: BE RD Date]
    Use         : Date Field
    Storage     : BE Entry Date
    Width       : 10
    Color       : If $$IsEmpty:##BE Entry Date Then Red Else Black

[Field: BE RD Ledger]
    Use         : Name Field
    Storage     : BE Entry Ledger
    Width       : 25
    Table       : Ledger
    Show Table  : Always
    Color       : If $$IsEmpty:##BE Entry Ledger Then Red Else Black

[Field: BE RD BillRef]
    Use         : Name Field
    Storage     : BE Entry BillRef
    Width       : 12
    Set Always  : Yes
    Default     : "New Ref"

[Field: BE RD Amount]
    Use         : Amount Field
    Storage     : BE Entry Amount
    Width       : 15
    Color       : If ##BE Entry Amount <= 0 Then Red Else Black

[Field: BE RD TxnType]
    Use         : Name Field
    Storage     : BE Entry TxnType
    Width       : 10
    List        : BE Transaction Type List
    Show List   : Always
    Default     : "Cash"

[Field: BE RD InstNo]
    Use         : Name Field
    Storage     : BE Entry InstNo
    Width       : 15
    Skip        : $$IsEmpty:##BE Entry TxnType OR ##BE Entry TxnType = "Cash"

[Field: BE RD InstDate]
    Use         : Date Field
    Storage     : BE Entry InstDate
    Width       : 10
    Skip        : $$IsEmpty:##BE Entry TxnType OR ##BE Entry TxnType = "Cash"

[Field: BE RD Narration]
    Use         : Name Field
    Storage     : BE Entry Narration
    Width       : 30

[Field: BE RD Status]
    Use         : Short Name Field
    Set as      : ##BE Entry Status
    Width       : 8
    Style       : Small
    Color       : If ##BE Entry Status = "Invalid" Then Red Else If ##BE Entry Status = "Posted" Then Green Else Blue
    Skip        : Yes

[Collection: BE Receipt Entries Collection]
    Source Collection   : BE Receipt Entries
    Type                : BE Receipt Entry

[Part: BE Receipt Grid Footer]
    Lines       : BE Receipt Footer Line
    Repeat      : BE Receipt Footer Line : 1
    Scroll      : None

[Line: BE Receipt Footer Line]
    Fields      : BE Receipt Footer Field
    Local       : Field : Default : Style : Small Bold

[Field: BE Receipt Footer Field]
    Set as      : "[Ctrl+A] Save All  [Ctrl+N] New Row  [Alt+D] Delete Row  [Esc] Exit"
    Style       : Small Bold
    Align       : Centre
    Border      : Thin Top
    Color       : Blue

;; ============================================================================
;; SECTION 6: BULK PAYMENT GRID SCREEN
;; ============================================================================

[Form: BE Bulk Payment Grid]
    Width       : $$FullWidth
    Height      : $$FullHeight

    Parts       : BE Payment Grid Header, BE Payment Grid Body, BE Payment Grid Footer

    Keys        : Ctrl+A : Call : BE Save All Payments
    Keys        : Ctrl+N : Call : BE Add New Payment Row
    Keys        : Alt+D  : Call : BE Delete Payment Row

[Part: BE Payment Grid Header]
    Lines       : BE Payment Title Line, BE Payment Subtitle Line, BE Payment Column Headers
    Repeat      : BE Payment Title Line     : 1
    Repeat      : BE Payment Subtitle Line  : 1
    Repeat      : BE Payment Column Headers : 1
    Scroll      : None

[Line: BE Payment Title Line]
    Fields      : BE Payment Title Field
    Local       : Field : Default : Style : Normal Bold

[Field: BE Payment Title Field]
    Set as      : "Bulk Payment Entries For : " + ##BE Selected Bank
    Style       : Normal Bold
    Align       : Centre
    Border      : Thin Bottom

[Line: BE Payment Subtitle Line]
    Fields      : BE Payment Subtitle Field
    Local       : Field : Default : Style : Small Bold

[Field: BE Payment Subtitle Field]
    Set as      : "Entry for each line will be created and voucher numbers will be assigned automatically"
    Style       : Small
    Align       : Centre
    Color       : Blue
    Border      : Thin Bottom

[Line: BE Payment Column Headers]
    Fields      : BE PH Date, BE PH Ledger, BE PH BillRef, BE PH Amount, BE PH TxnType, BE PH InstNo, BE PH InstDate, BE PH Narration
    Local       : Field : Default : Style : Small Bold, Border : Thin Bottom

[Field: BE PH Date]
    Set as      : "Date"
    Width       : 10
    Align       : Centre

[Field: BE PH Ledger]
    Set as      : "Ledger Name"
    Width       : 25
    Align       : Left

[Field: BE PH BillRef]
    Set as      : "Bill Ref"
    Width       : 12
    Align       : Left

[Field: BE PH Amount]
    Set as      : "Amount"
    Width       : 15
    Align       : Right

[Field: BE PH TxnType]
    Set as      : "Txn Type"
    Width       : 10
    Align       : Left

[Field: BE PH InstNo]
    Set as      : "Inst. No"
    Width       : 15
    Align       : Left

[Field: BE PH InstDate]
    Set as      : "Inst. Date"
    Width       : 10
    Align       : Centre

[Field: BE PH Narration]
    Set as      : "Narration"
    Width       : 30
    Align       : Left

[Part: BE Payment Grid Body]
    Lines       : BE Payment Data Line
    Repeat      : BE Payment Data Line : BE Payment Entries Collection
    Scroll      : Vertical
    Common Border : Yes

[Line: BE Payment Data Line]
    Fields      : BE PD Date, BE PD Ledger, BE PD BillRef, BE PD Amount, BE PD TxnType, BE PD InstNo, BE PD InstDate, BE PD Narration, BE PD Status
    Right Fields: BE PD Status

    Local       : Field : Default : Width : 10

[Field: BE PD Date]
    Use         : Date Field
    Storage     : BE Entry Date
    Width       : 10
    Color       : If $$IsEmpty:##BE Entry Date Then Red Else Black

[Field: BE PD Ledger]
    Use         : Name Field
    Storage     : BE Entry Ledger
    Width       : 25
    Table       : Ledger
    Show Table  : Always
    Color       : If $$IsEmpty:##BE Entry Ledger Then Red Else Black

[Field: BE PD BillRef]
    Use         : Name Field
    Storage     : BE Entry BillRef
    Width       : 12
    Set Always  : Yes
    Default     : "New Ref"

[Field: BE PD Amount]
    Use         : Amount Field
    Storage     : BE Entry Amount
    Width       : 15
    Color       : If ##BE Entry Amount <= 0 Then Red Else Black

[Field: BE PD TxnType]
    Use         : Name Field
    Storage     : BE Entry TxnType
    Width       : 10
    List        : BE Transaction Type List
    Show List   : Always
    Default     : "Cash"

[Field: BE PD InstNo]
    Use         : Name Field
    Storage     : BE Entry InstNo
    Width       : 15
    Skip        : $$IsEmpty:##BE Entry TxnType OR ##BE Entry TxnType = "Cash"

[Field: BE PD InstDate]
    Use         : Date Field
    Storage     : BE Entry InstDate
    Width       : 10
    Skip        : $$IsEmpty:##BE Entry TxnType OR ##BE Entry TxnType = "Cash"

[Field: BE PD Narration]
    Use         : Name Field
    Storage     : BE Entry Narration
    Width       : 30

[Field: BE PD Status]
    Use         : Short Name Field
    Set as      : ##BE Entry Status
    Width       : 8
    Style       : Small
    Color       : If ##BE Entry Status = "Invalid" Then Red Else If ##BE Entry Status = "Posted" Then Green Else Blue
    Skip        : Yes

[Collection: BE Payment Entries Collection]
    Source Collection   : BE Payment Entries
    Type                : BE Payment Entry

[Part: BE Payment Grid Footer]
    Lines       : BE Payment Footer Line
    Repeat      : BE Payment Footer Line : 1
    Scroll      : None

[Line: BE Payment Footer Line]
    Fields      : BE Payment Footer Field
    Local       : Field : Default : Style : Small Bold

[Field: BE Payment Footer Field]
    Set as      : "[Ctrl+A] Save All  [Ctrl+N] New Row  [Alt+D] Delete Row  [Esc] Exit"
    Style       : Small Bold
    Align       : Centre
    Border      : Thin Top
    Color       : Blue

;; ============================================================================
;; SECTION 7: TRANSACTION TYPE LIST
;; ============================================================================

[List: BE Transaction Type List]
    Title       : "Transaction Types"
    List        : Cash, Cheque, NEFT, RTGS, UPI, IMPS, Others

;; ============================================================================
;; SECTION 8: XML IMPORT SCREEN
;; ============================================================================

[Form: BE XML Import Screen]
    Width       : 70
    Height      : 15
    Border      : Thin Box

    Parts       : BE XML Import Header, BE XML Import Body, BE XML Import Buttons

[Part: BE XML Import Header]
    Lines       : BE XML Import Title
    Repeat      : BE XML Import Title : 1
    Scroll      : None

[Line: BE XML Import Title]
    Fields      : BE XML Import Title Field
    Local       : Field : Default : Style : Normal Bold

[Field: BE XML Import Title Field]
    Set as      : "=== BULK RECEIPT / PAYMENT VOUCHER IMPORT ==="
    Style       : Normal Bold
    Align       : Centre
    Border      : Thin Bottom
    Width       : 70

[Part: BE XML Import Body]
    Lines       : BE XML File Line, BE XML Test Mode Line
    Repeat      : BE XML File Line : 1
    Repeat      : BE XML Test Mode Line : 1
    Scroll      : None

[Line: BE XML File Line]
    Fields      : BE XML File Label, BE XML File Value
    Local       : Field : Default : Width : 35

[Field: BE XML File Label]
    Set as      : "Input File (XML)"
    Width       : 20
    Style       : Normal Bold

[Field: BE XML File Value]
    Use         : Name Field
    Storage     : BE Import File Path
    Width       : 45
    Modifiable  : Yes

[Line: BE XML Test Mode Line]
    Fields      : BE XML Test Label, BE XML Test Value
    Local       : Field : Default : Width : 35

[Field: BE XML Test Label]
    Set as      : "Test Mode (No Save)"
    Width       : 20
    Style       : Normal Bold

[Field: BE XML Test Value]
    Use         : Name Field
    Storage     : BE Import Test Mode
    Width       : 45
    List        : BE Yes No List
    Show List   : Always
    Default     : "No"

[List: BE Yes No List]
    Title       : "Yes/No"
    List        : Yes, No

[Part: BE XML Import Buttons]
    Lines       : BE XML Button Line
    Repeat      : BE XML Button Line : 1
    Scroll      : None

[Line: BE XML Button Line]
    Fields      : BE XML Start Button, BE XML Cancel Button
    Local       : Field : Default : Width : 35

[Field: BE XML Start Button]
    Set as      : "[Enter] Start Import"
    Width       : 35
    Align       : Centre
    Style       : Normal Bold
    Color       : Green
    Keys        : Enter : Call : BE Process XML Import

[Field: BE XML Cancel Button]
    Set as      : "[Esc] Cancel"
    Width       : 35
    Align       : Centre
    Style       : Normal Bold
    Color       : Red

;; ============================================================================
