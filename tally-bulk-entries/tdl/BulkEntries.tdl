[Part: BE Config Body]
    Lines       : BE Config Receipt VchType Line, BE Config Payment VchType Line, BE Config Txn Types Line, BE Config Narration Line, BE Config Save Line
    Repeat      : BE Config Receipt VchType Line   : 1
    Repeat      : BE Config Payment VchType Line   : 1
    Repeat      : BE Config Txn Types Line         : 1
    Repeat      : BE Config Narration Line         : 1
    Repeat      : BE Config Save Line              : 1
    Scroll      : Vertical

[Line: BE Config Receipt VchType Line]
    Fields      : BE Config Receipt Label, BE Config Receipt Value
    Local       : Field : Default : Width : 35

[Field: BE Config Receipt Label]
    Set as      : "Default Receipt Voucher Type"
