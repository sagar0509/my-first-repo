[Form: BE Config Screen]
    Width       : 70
    Height      : 20
    Border      : Thin Box

    Parts       : BE Config Header, BE Config Body

[Part: BE Config Header]
    Lines       : BE Config Title
    Repeat      : BE Config Title : 1
    Scroll      : None

[Line: BE Config Title]
    Fields      : BE Config Title Field
    Local       : Field : Default : Style : Normal Bold

[Field: BE Config Title Field]
    Set as      : "Bulk Entries Configuration"
    Style       : Normal Bold
    Align       : Centre
    Border      : Thin Bottom
