<?xml version="1.0" encoding="UTF-8"?>
<!--
    Sample XML File for Bulk Receipt Import

    Usage: Use this file in the XML Import screen (Bulk Entries → XML Import)

    Instructions:
    1. Modify bank ledger name to match your company's bank account
    2. Update party ledger names to existing ledgers in your company
    3. Adjust dates to current financial year
    4. Save and use in import screen
-->

<ENVELOPE>
    <HEADER>
        <TALLYREQUEST>Import Data</TALLYREQUEST>
    </HEADER>
    <BODY>
        <IMPORTDATA>
            <REQUESTDESC>
                <REPORTNAME>Vouchers</REPORTNAME>
                <STATICVARIABLES>
                    <SVCURRENTCOMPANY>Your Company Name</SVCURRENTCOMPANY>
                </STATICVARIABLES>
            </REQUESTDESC>
            <REQUESTDATA>

                <!-- Receipt Entry 1: Cash Receipt -->
                <TALLYMESSAGE xmlns:UDF="TallyUDF">
                    <VOUCHER REMOTEID="" VCHKEY="" VCHTYPE="Receipt" ACTION="Create" OBJVIEW="Accounting Voucher View">
                        <DATE>20251220</DATE>
                        <GUID></GUID>
                        <NARRATION>Payment received for Invoice #INV-2025-001</NARRATION>
                        <VOUCHERTYPENAME>Receipt</VOUCHERTYPENAME>
                        <VOUCHERNUMBER>1</VOUCHERNUMBER>
                        <PARTYLEDGERNAME>Customer ABC Ltd</PARTYLEDGERNAME>
                        <EFFECTIVEDATE>20251220</EFFECTIVEDATE>
                        <PERSISTEDVIEW>Accounting Voucher View</PERSISTEDVIEW>

                        <ALLLEDGERENTRIES.LIST>
                            <LEDGERNAME>HDFC Bank Current Account</LEDGERNAME>
                            <ISDEEMEDPOSITIVE>Yes</ISDEEMEDPOSITIVE>
                            <AMOUNT>50000.00</AMOUNT>
                            <BANKALLOCATIONS.LIST>
                                <DATE>20251220</DATE>
                                <TRANSACTIONTYPE>Cash</TRANSACTIONTYPE>
                                <PAYMENTFAVOURING>Customer ABC Ltd</PAYMENTFAVOURING>
                                <AMOUNT>50000.00</AMOUNT>
                            </BANKALLOCATIONS.LIST>
                        </ALLLEDGERENTRIES.LIST>

                        <ALLLEDGERENTRIES.LIST>
                            <LEDGERNAME>Customer ABC Ltd</LEDGERNAME>
                            <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
                            <AMOUNT>-50000.00</AMOUNT>
                            <BILLALLOCATIONS.LIST>
                                <NAME>INV-2025-001</NAME>
                                <BILLTYPE>New Ref</BILLTYPE>
                                <AMOUNT>-50000.00</AMOUNT>
                            </BILLALLOCATIONS.LIST>
                        </ALLLEDGERENTRIES.LIST>
                    </VOUCHER>
                </TALLYMESSAGE>

