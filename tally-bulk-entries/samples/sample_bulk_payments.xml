                        <ALLLEDGERENTRIES.LIST>
                            <LEDGERNAME>HDFC Bank Current Account</LEDGERNAME>
                            <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
                            <AMOUNT>-95000.00</AMOUNT>
                            <BANKALLOCATIONS.LIST>
                                <DATE>20251221</DATE>
                                <TRANSACTIONTYPE>NEFT</TRANSACTIONTYPE>
                                <INSTRUMENTNUMBER>NEFT555666777</INSTRUMENTNUMBER>
                                <INSTRUMENTDATE>20251221</INSTRUMENTDATE>
                                <PAYMENTFAVOURING>Supplier Materials Ltd</PAYMENTFAVOURING>
                                <AMOUNT>-95000.00</AMOUNT>
                            </BANKALLOCATIONS.LIST>
                        </ALLLEDGERENTRIES.LIST>
                    </VOUCHER>
                </TALLYMESSAGE>

                <!-- Payment Entry 3: Cheque Payment for Expense -->
                <TALLYMESSAGE xmlns:UDF="TallyUDF">
                    <VOUCHER REMOTEID="" VCHKEY="" VCHTYPE="Payment" ACTION="Create" OBJVIEW="Accounting Voucher View">
                        <DATE>20251222</DATE>
                        <GUID></GUID>
                        <NARRATION>Office rent payment for December 2025 | Txn: Cheque | Inst: 789456 | Dt: 22-Dec-2025</NARRATION>
