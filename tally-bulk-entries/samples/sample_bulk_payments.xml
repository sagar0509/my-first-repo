<?xml version="1.0" encoding="UTF-8"?>
<!--
    Sample XML File for Bulk Payment Import

    Usage: Use this file in the XML Import screen (Bulk Entries → XML Import)

    Instructions:
    1. Modify bank ledger name to match your company's bank account
    2. Update party/expense ledger names to existing ledgers in your company
    3. Adjust dates to current financial year
    4. Save and use in import screen
-->

<ENVELOPE>
    <HEADER>
        <TALLYREQUEST>Import Data</TALLYREQUEST>
    </HEADER>
    <BODY>
        <IMPORTDATA>
            <REQUESTDESC>
                <REPORTNAME>Vouchers</REPORTNAME>
                <STATICVARIABLES>
                    <SVCURRENTCOMPANY>Your Company Name</SVCURRENTCOMPANY>
                </STATICVARIABLES>
            </REQUESTDESC>
            <REQUESTDATA>

                <!-- Payment Entry 1: Cash Payment for Supplier -->
                <TALLYMESSAGE xmlns:UDF="TallyUDF">
                    <VOUCHER REMOTEID="" VCHKEY="" VCHTYPE="Payment" ACTION="Create" OBJVIEW="Accounting Voucher View">
                        <DATE>20251220</DATE>
                        <GUID></GUID>
                        <NARRATION>Payment made for Purchase Invoice #PUR-2025-101</NARRATION>
                        <VOUCHERTYPENAME>Payment</VOUCHERTYPENAME>
                        <VOUCHERNUMBER>1</VOUCHERNUMBER>
                        <PARTYLEDGERNAME>Supplier Goods Pvt Ltd</PARTYLEDGERNAME>
                        <EFFECTIVEDATE>20251220</EFFECTIVEDATE>
                        <PERSISTEDVIEW>Accounting Voucher View</PERSISTEDVIEW>

                        <ALLLEDGERENTRIES.LIST>
                            <LEDGERNAME>Supplier Goods Pvt Ltd</LEDGERNAME>
                            <ISDEEMEDPOSITIVE>Yes</ISDEEMEDPOSITIVE>
                            <AMOUNT>35000.00</AMOUNT>
                            <BILLALLOCATIONS.LIST>
                                <NAME>PUR-2025-101</NAME>
                                <BILLTYPE>Agst Ref</BILLTYPE>
                                <AMOUNT>35000.00</AMOUNT>
                            </BILLALLOCATIONS.LIST>
                        </ALLLEDGERENTRIES.LIST>

                        <ALLLEDGERENTRIES.LIST>
                            <LEDGERNAME>HDFC Bank Current Account</LEDGERNAME>
                            <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
                            <AMOUNT>-35000.00</AMOUNT>
                            <BANKALLOCATIONS.LIST>
                                <DATE>20251220</DATE>
                                <TRANSACTIONTYPE>Cash</TRANSACTIONTYPE>
                                <PAYMENTFAVOURING>Supplier Goods Pvt Ltd</PAYMENTFAVOURING>
                                <AMOUNT>-35000.00</AMOUNT>
                            </BANKALLOCATIONS.LIST>
                        </ALLLEDGERENTRIES.LIST>
                    </VOUCHER>
                </TALLYMESSAGE>

                <!-- Payment Entry 2: NEFT Payment for Supplier -->
                <TALLYMESSAGE xmlns:UDF="TallyUDF">
                    <VOUCHER REMOTEID="" VCHKEY="" VCHTYPE="Payment" ACTION="Create" OBJVIEW="Accounting Voucher View">
                        <DATE>20251221</DATE>
                        <GUID></GUID>
                        <NARRATION>NEFT payment for Purchase Invoice #PUR-2025-102 | Txn: NEFT | Inst: NEFT555666777 | Dt: 21-Dec-2025</NARRATION>
